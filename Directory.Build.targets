<Project>

  <!--
    Projects that set <BundleDevicePlugins>true</BundleDevicePlugins> (the apps, and the tests that build a real
    session) get the K8055 and Busylight plugins copied to plugins/<name> in their output, so those devices load
    through the plugin loader like any third-party plugin. See docs/design/proposals/plugin-contributed-panels.md.
  -->
  <ItemGroup Condition="'$(BundleDevicePlugins)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/DevTerm.Devices.K8055/DevTerm.Devices.K8055.csproj" ReferenceOutputAssembly="false" Condition="!$(MSBuildProjectName.StartsWith('DevTerm.Console.Tests')) And !$(MSBuildProjectName.StartsWith('DevTerm.Wpf.Tests'))" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/DevTerm.Devices.Busylight/DevTerm.Devices.Busylight.csproj" ReferenceOutputAssembly="false" Condition="!$(MSBuildProjectName.StartsWith('DevTerm.Console.Tests')) And !$(MSBuildProjectName.StartsWith('DevTerm.Wpf.Tests'))" />
  </ItemGroup>

  <Target Name="BundleDevicePlugins" AfterTargets="Build" Condition="'$(BundleDevicePlugins)' == 'true'">
    <ItemGroup>
      <_K8055Plugin Include="$(MSBuildThisFileDirectory)src/DevTerm.Devices.K8055/bin/$(Configuration)/net10.0/DevTerm.Devices.K8055.dll;$(MSBuildThisFileDirectory)src/DevTerm.Devices.K8055/bin/$(Configuration)/net10.0/plugin.json" />
      <_BusylightPlugin Include="$(MSBuildThisFileDirectory)src/DevTerm.Devices.Busylight/bin/$(Configuration)/net10.0/DevTerm.Devices.Busylight.dll;$(MSBuildThisFileDirectory)src/DevTerm.Devices.Busylight/bin/$(Configuration)/net10.0/plugin.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_K8055Plugin)" DestinationFolder="$(OutDir)plugins/k8055" />
    <Copy SourceFiles="@(_BusylightPlugin)" DestinationFolder="$(OutDir)plugins/busylight" />
  </Target>

</Project>
