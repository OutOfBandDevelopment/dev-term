<Project>

  <!--
    Applies to every project in the solution automatically (MSBuild convention — no per-csproj
    edits needed). See docs/coding-standards.md for what this enforces and why.
  -->

  <PropertyGroup>
    <!-- Makes the built-in .NET/Roslyn code-style analyzers (the ones .editorconfig's
         csharp_style_*/dotnet_style_* keys configure) actually run and report during `dotnet build`,
         not just in the IDE — matching CLAUDE.md's existing "dotnet build surfaces analyzer
         warnings" convention rather than adding a second, separate lint step. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Analyzer diagnostics are warnings, not build-breaking errors, for this baseline — see
         .editorconfig's own header comment for why. Flip specific rules to `error` severity in
         .editorconfig once they're solid enough to actually block a build over. -->
    <WarningsAsErrors />

    <!-- StyleCop.Analyzers 1.1.118 crashes (not a real finding, an unhandled exception inside the
         analyzer itself) on a `record struct` declaration (SA1201's member-order table has no
         entry for that syntax kind) and on DevTerm.Transports.Tcp.Tests's SocketExceptionStub class
         (SA1500/SA1502/SA1508 all NullReferenceException in the same token lookup). Roslyn reports
         these as AD0001, which is a `NotConfigurable` diagnostic - `dotnet_diagnostic.AD0001.severity`
         in .editorconfig is silently ignored for it, so NoWarn (a compiler-option-level filter) is
         the only thing that actually suppresses it. Revisit if/when StyleCop.Analyzers ships a fix. -->
    <NoWarn>$(NoWarn);AD0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- StyleCop.Analyzers: most of its rules are disabled via .editorconfig (see that file's own
         comments) since they don't match this project's established conventions yet — enabled here
         so new rules can be turned on incrementally, one at a time, as a standard is actually
         declared for them, without a second round of per-project wiring. -->
    <PackageReference Include="StyleCop.Analyzers" Version="1.1.118" PrivateAssets="all" />
  </ItemGroup>

</Project>
