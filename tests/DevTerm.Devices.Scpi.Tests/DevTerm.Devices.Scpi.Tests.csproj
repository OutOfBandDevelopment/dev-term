<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="MSTest" Version="4.4.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DevTerm.Devices.Scpi\DevTerm.Devices.Scpi.csproj" />
    <ProjectReference Include="..\..\src\DevTerm.Core\DevTerm.Core.csproj" />
    <ProjectReference Include="..\..\src\DevTerm.UiDefinitions\DevTerm.UiDefinitions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- So ScpiProfileCatalog.All/TryMatchByIdn have the real bundled profiles to match against in
         this test process too (this project's own AppContext.BaseDirectory), not just an empty list
         - ScpiProfileCatalogTests exercises the drop-in/synthetic-directory loading path separately
         via the internal Load(baseDirectory) overload. -->
    <None Include="..\..\src\DevTerm.Devices.Scpi\Profiles\*.json" Link="Profiles\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
