<?xml version="1.0" encoding="utf-8"?>
<!--
  Opt-in real-hardware test parameters (see CLAUDE.md's "Testing" section). Not used unless a test
  run explicitly passes this file via dotnet test's "settings" option followed by this file's path
  (the literal flag spelling isn't written here because XML comments can't contain two consecutive
  hyphens, which that flag needs).

  Tests that read these (RealHardware*Tests classes) report Assert.Inconclusive - not a failure -
  when run without this file, so the default `dotnet test` (no settings flag) stays hardware-free.
  These are the same real devices already referenced by src/DevTerm.Console/Properties/launchSettings.json's
  "TCP 192.168.0.107:23 ASCII" / "TCP 192.168.0.108:23 ASCII" profiles (a real Tektronix 2230
  oscilloscope, reachable over a serial-to-Ethernet bridge) - override the values below (or pass
  your own settings file) if those two hosts aren't reachable from wherever this runs.

  RealTcpDeviceHost3 is a real Tektronix TDS2024 oscilloscope, also over a serial-to-Ethernet
  bridge - a different, SCPI-based device family: it identifies via "*IDN?" (SCPI standard), not
  the "ID?" the pre-SCPI 2230s above use.

  The *Query and *ExpectedReply values below are each host's identity-query text and expected reply
  substring, read by RealHardwareCliTests as separate parameters (not baked into the test as
  literals) so a new real device can be added later with only new parameters plus one new DataRow,
  no code change - and so an unverified guess can be corrected here instead of in code.
  RealTcpDeviceHost3ExpectedReply ("TEKTRONIX", the standard *IDN? response's manufacturer field)
  has NOT been confirmed against this specific real unit yet - tighten it once it has been (e.g.
  the full model/firmware string), or clear it to make that DataRow report Inconclusive instead of
  asserting an unverified value.
-->
<RunSettings>
    <TestRunParameters>
        <Parameter name="RealTcpDeviceHost1" value="192.168.0.107" />
        <Parameter name="RealTcpDeviceHost2" value="192.168.0.108" />
        <Parameter name="RealTcpDeviceHost3" value="192.168.0.110" />
        <Parameter name="RealTcpDevicePort" value="23" />
        <Parameter name="RealTcpDeviceHost1Query" value="ID?" />
        <Parameter name="RealTcpDeviceHost2Query" value="ID?" />
        <Parameter name="RealTcpDeviceHost3Query" value="*IDN?" />
        <Parameter name="RealTcpDeviceHost1ExpectedReply" value="TEK/2230" />
        <Parameter name="RealTcpDeviceHost2ExpectedReply" value="TEK/2230" />
        <Parameter name="RealTcpDeviceHost3ExpectedReply" value="TEKTRONIX" />
    </TestRunParameters>

    <!-- Controls parallelism at the vstest.console.exe level (across test containers/assemblies) -->
    <RunConfiguration>
        <MaxCpuCount>0</MaxCpuCount>
        <!-- 0 = use all available cores; or set a specific number like 4 -->
    </RunConfiguration>

    <!-- Controls parallelism within MSTest (across classes/methods in the same assembly) -->
    <MSTest>
        <Parallelize>
            <Workers>0</Workers>
            <!-- 0 = number of available cores -->
            <Scope>MethodLevel</Scope>
            <!-- or ClassLevel -->
        </Parallelize>
    </MSTest>
</RunSettings>
