<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DevTerm.Core\DevTerm.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="libusb-dynamic" Version="1.0.26" GeneratePathProperty="true" />
    <PackageReference Include="LibUsbDotNet" Version="3.0.224" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.12" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- LibUsbDotNet is a managed P/Invoke wrapper only — it needs the native libusb-1.0 shared
       library on the loader search path, which nothing installs by default on Windows. The
       libusb-dynamic package above is a vcpkg export (its own build/native props/targets target
       native C++ projects, not this one) referenced purely so restore fetches a matching win-x64
       build of libusb-1.0.dll, copied here into this project's own (and, via the standard
       ProjectReference content-propagation behavior, DevTerm.Console's) output directory. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <None Include="$(Pkglibusb-dynamic)\installed\x64-windows\bin\libusb-1.0.dll"
          Condition="Exists('$(Pkglibusb-dynamic)\installed\x64-windows\bin\libusb-1.0.dll')"
          CopyToOutputDirectory="PreserveNewest"
          Link="libusb-1.0.dll" />
  </ItemGroup>

</Project>
