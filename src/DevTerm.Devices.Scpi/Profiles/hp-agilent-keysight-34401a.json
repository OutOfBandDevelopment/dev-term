{
  "Name": "HP/Agilent/Keysight 34401A Digital Multimeter",
  "IdnPattern": "34401A",
  "Terminator": "\n",
  "Notes": "Confirmed against real hardware 2026-09-23 over RS-232: 9600 baud, 8 data bits, 2 stop bits (fixed on this instrument), no parity, no hardware handshake, LF line terminator. Unlike GPIB, RS-232 on the 34401A never auto-enters remote mode - send Remote (SYSTem:REMote) before any query, or the instrument answers with SCPI error +550 \"Command not allowed in local\" and no measurement.",
  "Commands": [
    { "Id": "idn", "Label": "Identify", "Category": "Common", "Template": "*IDN?", "IsQuery": true },
    { "Id": "remote", "Label": "Remote", "Category": "Common", "Template": "SYSTem:REMote" },
    { "Id": "rst", "Label": "Reset", "Category": "Common", "Template": "*RST" },
    { "Id": "measVoltDc", "Label": "Measure DC Voltage", "Category": "Measure", "Template": "MEAS:VOLT:DC?", "IsQuery": true },
    { "Id": "measVoltAc", "Label": "Measure AC Voltage", "Category": "Measure", "Template": "MEAS:VOLT:AC?", "IsQuery": true },
    { "Id": "measCurrDc", "Label": "Measure DC Current", "Category": "Measure", "Template": "MEAS:CURR:DC?", "IsQuery": true },
    { "Id": "measRes", "Label": "Measure Resistance", "Category": "Measure", "Template": "MEAS:RES?", "IsQuery": true },
    { "Id": "measFreq", "Label": "Measure Frequency", "Category": "Measure", "Template": "MEAS:FREQ?", "IsQuery": true },
    {
      "Id": "confVoltDc",
      "Label": "Configure DC Voltage Range",
      "Category": "Configure",
      "Template": "CONF:VOLT:DC {Range}",
      "Parameters": [
        { "Name": "Range", "Kind": "Choice", "Options": ["AUTO", "0.1", "1", "10", "100", "1000"], "DefaultValue": "AUTO" }
      ]
    }
  ]
}
