<Window x:Class="DevTerm.Wpf.PlaybackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:playback="clr-namespace:DevTerm.Logging.Playback;assembly=DevTerm.Logging"
        Title="dev-term — Playback" Height="560" Width="820" MinHeight="400" MinWidth="640">
    <DockPanel Margin="8">
        <!-- What's being played: the log's connection, capture time, record count. -->
        <TextBlock x:Name="DescriptionText" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" />

        <!-- Which presenters the log is replayed through: one check box per installed presenter.
             Changing the choice replays up to the current position through the new set. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock Text="Presenters:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ItemsControl x:Name="PresenterChoices">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,0,12,0"
                                  Checked="PresenterChoice_Changed" Unchecked="PresenterChoice_Changed" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!-- Editing: trim selection and notes. -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <Button x:Name="MarkInButton" Content="Mark _In" Padding="10,2" Click="MarkIn_Click" ToolTip="Trim starts at the current position" />
            <Button x:Name="MarkOutButton" Content="Mark _Out" Padding="10,2" Margin="6,0,0,0" Click="MarkOut_Click" ToolTip="Trim ends at the current position" />
            <Button x:Name="SaveSelectionButton" Content="Sa_ve Selection..." Padding="10,2" Margin="6,0,0,0" Click="SaveSelection_Click" ToolTip="Save the selected records as a new log" />
            <Button x:Name="AddNoteButton" DockPanel.Dock="Right" Content="Add _Note" Padding="10,2" Margin="6,0,0,0" Click="AddNote_Click" ToolTip="Add the note at the current position (saved into the log)" />
            <TextBox x:Name="NoteBox" Margin="18,0,0,0" VerticalContentAlignment="Center" KeyDown="NoteBox_KeyDown" ToolTip="A note to add at the current position" />
        </DockPanel>

        <!-- Transport controls. -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" LastChildFill="False">
            <Button x:Name="RewindButton" Content="|◀ _Rewind" Padding="10,2" Click="Rewind_Click" />
            <Button x:Name="StepButton" Content="S_tep" Padding="10,2" Margin="6,0,0,0" Click="Step_Click" />
            <Button x:Name="PlayButton" Content="▶ _Play" Padding="10,2" Margin="6,0,0,0" MinWidth="80" Click="Play_Click" />
            <Button x:Name="FastForwardButton" Content="+10_s ▶▶" Padding="10,2" Margin="6,0,0,0" Click="FastForward_Click" ToolTip="Skip ahead 10 seconds of log time" />
            <Button x:Name="EndButton" Content="_End ▶|" Padding="10,2" Margin="6,0,0,0" Click="End_Click" />
            <TextBlock Text="Speed:" VerticalAlignment="Center" Margin="18,0,6,0" />
            <ComboBox x:Name="SpeedBox" Width="70" SelectionChanged="SpeedBox_SelectionChanged" />
        </DockPanel>

        <!-- Position: a seek slider over the records, and the position text. -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <TextBlock x:Name="PositionText" DockPanel.Dock="Bottom" FontFamily="Consolas" Margin="0,4,0,0" />
            <Slider x:Name="PositionSlider" Minimum="0" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="PositionSlider_ValueChanged" />
        </DockPanel>

        <ListBox x:Name="OutputList" FontFamily="Consolas" ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type playback:PlaybackLine}">
                    <TextBlock x:Name="LineText" Text="{Binding Text}" />
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static playback:PlaybackLineKind.Sent}">
                            <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource DevTerm.Accent}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static playback:PlaybackLineKind.Status}">
                            <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource DevTerm.OutputStatus}" />
                            <Setter TargetName="LineText" Property="FontStyle" Value="Italic" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static playback:PlaybackLineKind.Error}">
                            <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource DevTerm.OutputError}" />
                            <Setter TargetName="LineText" Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static playback:PlaybackLineKind.Note}">
                            <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource DevTerm.Warning}" />
                            <Setter TargetName="LineText" Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
