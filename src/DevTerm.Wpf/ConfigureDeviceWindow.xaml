<Window x:Class="DevTerm.Wpf.ConfigureDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dev-term — Configure device" Height="560" Width="640" MinHeight="360" MinWidth="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ReadButton" Content="Read from device" Width="130" Height="32" Margin="0,0,8,0" Click="ReadButton_Click" />
            <Button x:Name="WriteButton" Content="Write to device" Width="120" Height="32" Margin="0,0,8,0" Click="WriteButton_Click" />
            <Button Content="Close" Width="80" Height="32" IsCancel="True" />
        </StackPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,8,0,0" />
        <TextBlock x:Name="SummaryText" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,8,0,0" />
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Editor" Grid.Row="0" Margin="0,0,10,6" VerticalAlignment="Center" />
            <ComboBox x:Name="EditorBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,6" DisplayMemberPath="Title" SelectionChanged="EditorBox_SelectionChanged" />
            <TextBlock Text="Host" Grid.Row="1" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBox x:Name="HostBox" Grid.Row="1" Grid.Column="1" />
            <TextBlock Text="Port" Grid.Row="1" Grid.Column="2" Margin="10,0,6,0" VerticalAlignment="Center" />
            <TextBox x:Name="PortBox" Grid.Row="1" Grid.Column="3" />
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid x:Name="FormGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
