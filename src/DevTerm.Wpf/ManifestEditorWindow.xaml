<Window x:Class="DevTerm.Wpf.ManifestEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dev-term — Manifest Editor" Height="660" Width="1180" MinHeight="420" MinWidth="820"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="New" Padding="10,2" Margin="0,0,6,0" Click="New_Click" />
            <Button Content="Open..." Padding="10,2" Margin="0,0,6,0" Click="Open_Click" />
            <Button Content="Save" Padding="10,2" Margin="0,0,6,0" Click="Save_Click" />
            <Button Content="Save As..." Padding="10,2" Margin="0,0,6,0" Click="SaveAs_Click" />
            <Button Content="Check" Padding="10,2" Margin="0,0,6,0" Click="Validate_Click"
                    ToolTip="Run the same checks the manifest loader runs (Save runs them too)" />
            <Button Content="Close" Padding="10,2" IsCancel="True" Click="Close_Click" />
        </StackPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="160" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="280" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- The outline: every part of the manifest; selecting one shows its generated form. -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Outline" FontWeight="Bold" Margin="0,0,0,4" />
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Button x:Name="AddButton" Content="Add" Padding="8,2" Margin="0,0,4,4" Click="Add_Click" />
                    <Button x:Name="RemoveButton" Content="Remove" Padding="8,2" Margin="0,0,4,4" Click="Remove_Click" />
                    <Button x:Name="UpButton" Content="Up" Padding="8,2" Margin="0,0,4,4" Click="Up_Click" />
                    <Button x:Name="DownButton" Content="Down" Padding="8,2" Margin="0,0,4,4" Click="Down_Click" />
                </WrapPanel>
                <ListBox x:Name="OutlineList" DisplayMemberPath="Display" SelectionChanged="OutlineList_SelectionChanged"
                         FontFamily="Consolas" />
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />

            <!-- The selected part's form: generated from its form model by FormRenderer. -->
            <DockPanel Grid.Column="2">
                <TextBlock x:Name="PaneTitle" DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,4" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock x:Name="HintText" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Button x:Name="CreatePanelButton" Content="Create panel from commands" Padding="8,2" HorizontalAlignment="Left"
                                Margin="0,0,0,8" Click="CreatePanel_Click" />
                        <ContentControl x:Name="FormHost" Focusable="False" IsTabStop="False" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" />

            <!-- The live preview: the real control-panel renderer against a surface that sends nothing. -->
            <DockPanel Grid.Column="4">
                <TextBlock DockPanel.Dock="Top" Text="Preview (sends nothing)" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBlock x:Name="PreviewSentText" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,4,0,0" />
                <Border x:Name="PreviewHost" BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
