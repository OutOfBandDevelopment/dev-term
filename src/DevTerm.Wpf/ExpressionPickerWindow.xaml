<Window x:Class="DevTerm.Wpf.ExpressionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dev-term — Expression" Height="460" Width="560" MinHeight="380" MinWidth="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="80" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Expression:" />
        <TextBox x:Name="ExpressionBox" Grid.Row="1" Margin="0,4,0,0" VerticalContentAlignment="Center" FontFamily="Consolas" AcceptsReturn="False" TextChanged="ExpressionBox_TextChanged" />
        <TextBlock x:Name="DiagnosticsText" Grid.Row="2" Margin="0,6,0,0" TextWrapping="Wrap" MinHeight="32" />
        <DockPanel Grid.Row="3" Margin="0,8,0,4">
            <TextBlock DockPanel.Dock="Left" Text="Find a value:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="FilterBox" VerticalContentAlignment="Center" TextChanged="FilterBox_TextChanged" />
        </DockPanel>
        <ListBox x:Name="PathList" Grid.Row="4" MouseDoubleClick="PathList_MouseDoubleClick" ToolTip="Double-click a value to insert it at the caret" />
        <WrapPanel x:Name="FunctionPanel" Grid.Row="5" Margin="0,8,0,0">
            <TextBlock Text="Functions:" VerticalAlignment="Center" Margin="0,0,8,0" />
        </WrapPanel>
        <DockPanel Grid.Row="6" Margin="0,10,0,0">
            <TextBlock x:Name="ResultText" DockPanel.Dock="Left" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Next sample" Width="100" Height="32" Margin="0,0,8,0" Click="NextSample_Click" />
                <Button Content="OK" Width="80" Height="32" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
                <Button Content="Cancel" Width="80" Height="32" IsCancel="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
