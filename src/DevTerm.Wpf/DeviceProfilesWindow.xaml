<Window x:Class="DevTerm.Wpf.DeviceProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dev-term — Device Profiles" Height="600" Width="460"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="DarkRed" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Connect" Padding="12,4" Margin="0,0,8,0" IsDefault="True" Command="{Binding ConnectCommand}" />
            <Button Content="Close" Padding="12,4" IsCancel="True" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="Saved profiles:" Margin="0,0,0,4" />
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Load" Padding="8,2" VerticalAlignment="Top" Command="{Binding LoadCommand}" />
            <ListBox x:Name="ProfilesList" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfileName}" Height="70" Margin="0,0,8,0" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Transport:" VerticalAlignment="Center" />
                    <ComboBox x:Name="TransportBox" Grid.Column="1" ItemsSource="{Binding TransportOptions}" SelectedItem="{Binding Transport}" />
                </Grid>

                <StackPanel x:Name="SerialPanel" Visibility="{Binding IsSerialTransport, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Serial" FontWeight="Bold" Margin="0,8,0,2" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Port:" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Baud:" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding Baud, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="TcpPanel" Visibility="{Binding IsTcpTransport, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="TCP" FontWeight="Bold" Margin="0,8,0,2" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Host:" VerticalAlignment="Center" />
                        <TextBox x:Name="HostBox" Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Port:" VerticalAlignment="Center" />
                        <TextBox x:Name="TcpPortBox" Grid.Column="1" Text="{Binding TcpPort, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <CheckBox Content="Listen (server mode)" IsChecked="{Binding Listen}" Margin="140,0,0,4" />
                </StackPanel>

                <StackPanel x:Name="HidPanel" Visibility="{Binding IsHidTransport, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="USB HID" FontWeight="Bold" Margin="0,8,0,2" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Vendor ID (decimal):" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding HidVendorId, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Product ID (decimal):" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding HidProductId, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </StackPanel>

                <TextBlock Text="Presentation" FontWeight="Bold" Margin="0,8,0,2" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Presenter:" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding PresenterOptions}" SelectedItem="{Binding Presenter}" />
                </Grid>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Line ending:" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding LineEndingOptions}" SelectedItem="{Binding LineEndingText}" />
                </Grid>

                <DockPanel Margin="0,12,0,0">
                    <TextBlock DockPanel.Dock="Top" Text="Save as profile named:" Margin="0,0,0,4" />
                    <Button DockPanel.Dock="Right" Content="Save Profile" Padding="8,2" Command="{Binding SaveCommand}" />
                    <TextBox Margin="0,0,8,0" Text="{Binding SaveName, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>

                <DockPanel Margin="0,12,0,0">
                    <TextBlock DockPanel.Dock="Top" Text="Import/export file path:" Margin="0,0,0,4" />
                    <Button DockPanel.Dock="Right" Content="Browse..." Padding="8,2" Click="Browse_Click" />
                    <TextBox Margin="0,0,8,0" Text="{Binding ImportExportPath, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                    <Button Content="Import" Padding="8,2" Margin="0,0,8,0" Command="{Binding ImportCommand}" />
                    <Button Content="Export" Padding="8,2" Command="{Binding ExportCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
