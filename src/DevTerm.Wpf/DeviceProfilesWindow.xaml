<Window x:Class="DevTerm.Wpf.DeviceProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dev-term — Device Profiles" Height="320" Width="420"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Pick a saved connection profile and apply it as the default — dev-term needs to restart to connect with it." />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="ApplyButton" Content="Apply as Default" Padding="12,4" Margin="0,0,8,0" Click="Apply_Click" />
            <Button Content="Close" Padding="12,4" IsCancel="True" />
        </StackPanel>
        <ListBox x:Name="ProfilesList" />
    </DockPanel>
</Window>
