<Window x:Class="DevTerm.Wpf.DeviceProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dev-term — Device Profiles" Height="640" Width="480" MinHeight="480" MinWidth="420"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="DarkRed" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Connect" Padding="12,4" Margin="0,0,8,0" IsDefault="True" Command="{Binding ConnectCommand}" />
            <Button Content="Close" Padding="12,4" IsCancel="True" />
        </StackPanel>

        <!-- Two proportional rows (not fixed heights) so both the saved-profiles list and the
             field editor below it grow/shrink together as the window is resized. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" MinHeight="90" />
                <RowDefinition Height="2*" MinHeight="160" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Top" Text="Saved profiles:" Margin="0,0,0,4" />
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top">
                    <Button Content="Load" Padding="8,2" Margin="0,0,0,4" Command="{Binding LoadCommand}" />
                    <Button Content="Delete" Padding="8,2" Margin="0,0,0,4" Command="{Binding DeleteCommand}" />
                    <Button Content="Delete Selected" Padding="8,2" Margin="0,0,0,4" Command="{Binding DeleteSelectedProfilesCommand}" />
                    <Button Content="Refresh" Padding="8,2" Margin="0,0,0,4" Command="{Binding RefreshCommand}" />
                    <Button Content="Export Selected" Padding="8,2" Margin="0,0,0,4" Command="{Binding ExportSelectedProfilesCommand}" />
                    <Button Content="Export All" Padding="8,2" Command="{Binding ExportAllProfilesCommand}" />
                </StackPanel>
                <!-- SelectionMode="Extended" (ctrl/shift-click, like Explorer) is what "Export Selected"
                     needs - ListBox.SelectedItems has no dependency property of its own to bind
                     two-way in pure XAML, so SelectionChanged pushes it into the view model's
                     SelectedProfileNames from code-behind instead (see DeviceProfilesWindow.xaml.cs).
                     SelectedItem stays bound as before - Load/Delete only ever act on one profile;
                     Export Selected/Delete Selected act on the whole multi-selection.
                     Double-click is a per-item MouseDoubleClick EventSetter, not a MouseBinding on the
                     ListBox: ListBoxItem marks the mouse-down handled (that's how it selects), so an
                     InputBinding on the ListBox never sees the second click of a double-click. -->
                <ListBox x:Name="ProfilesList" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfileName}"
                         SelectionMode="Extended" SelectionChanged="ProfilesList_SelectionChanged" Margin="0,0,8,0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <EventSetter Event="MouseDoubleClick" Handler="ProfilesList_ItemDoubleClick" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Transport:" VerticalAlignment="Center" />
                        <ComboBox x:Name="TransportBox" Grid.Column="1" ItemsSource="{Binding TransportOptions}" SelectedItem="{Binding Transport}" />
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Description:" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <StackPanel x:Name="SerialPanel" Visibility="{Binding IsSerialTransport, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Serial" FontWeight="Bold" Margin="0,8,0,2" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Port:" VerticalAlignment="Center" />
                            <TextBox x:Name="PortBox" Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Detected ports:" VerticalAlignment="Center" />
                            <ComboBox x:Name="DetectedPortsBox" Grid.Column="1" ItemsSource="{Binding SerialPortOptions}" DisplayMemberPath="Display" SelectedValuePath="Name" SelectedValue="{Binding SelectedSerialPort}" />
                        </Grid>
                        <!-- Same hint as the TUI's portNotFoundLabel: the saved port isn't one of the detected ports right now. -->
                        <TextBlock x:Name="PortNotFoundText" Margin="140,0,0,4" Foreground="DarkRed" TextWrapping="Wrap"
                                   Text="(not found — this port isn't connected right now)"
                                   Visibility="{Binding ConnectedDeviceNotFound, Converter={StaticResource BoolToVisibility}}" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Baud:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding Baud, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Data bits:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding DataBits, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Parity:" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ParityOptions}" SelectedItem="{Binding ParityText}" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Stop bits:" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding StopBitsOptions}" SelectedItem="{Binding StopBitsText}" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Handshake:" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding HandshakeOptions}" SelectedItem="{Binding HandshakeText}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="TcpPanel" Visibility="{Binding IsTcpTransport, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="TCP" FontWeight="Bold" Margin="0,8,0,2" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Host:" VerticalAlignment="Center" />
                            <TextBox x:Name="HostBox" Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Port:" VerticalAlignment="Center" />
                            <TextBox x:Name="TcpPortBox" Grid.Column="1" Text="{Binding TcpPort, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <CheckBox Content="Listen (server mode)" IsChecked="{Binding Listen}" Margin="140,0,0,4" />
                    </StackPanel>

                    <!-- Shared by the "hid" and "usbtmc" transports - both select a physical USB
                         device the same way (vendor/product ID, optionally a serial number), so
                         one field group serves both; only the detected-devices picker differs,
                         since HID and USBTMC devices come from different discovery sources. -->
                    <StackPanel x:Name="UsbDevicePanel" Visibility="{Binding IsUsbDeviceTransport, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="USB Device" FontWeight="Bold" Margin="0,8,0,2" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Vendor ID:" VerticalAlignment="Center" />
                            <TextBox x:Name="VendorBox" Grid.Column="1" Text="{Binding VendorIdDisplay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Product ID:" VerticalAlignment="Center" />
                            <TextBox x:Name="ProductBox" Grid.Column="1" Text="{Binding ProductIdDisplay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Serial number:" VerticalAlignment="Center" />
                            <TextBox x:Name="SerialNumberBox" Grid.Column="1" Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <CheckBox x:Name="IdsShowHexBox" Content="Show as hex" IsChecked="{Binding IdsShowHex}" Margin="140,0,0,4" />
                        <Grid x:Name="DetectedHidDevicesRow" Margin="0,0,0,4" Visibility="{Binding IsHidTransport, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Detected HID devices:" VerticalAlignment="Center" />
                            <ComboBox x:Name="DetectedHidDevicesBox" Grid.Column="1" ItemsSource="{Binding HidDeviceOptions}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedHidDevice}" />
                        </Grid>
                        <Grid x:Name="DetectedUsbtmcDevicesRow" Margin="0,0,0,4" Visibility="{Binding IsUsbtmcTransport, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Detected USBTMC devices:" VerticalAlignment="Center" />
                            <ComboBox x:Name="DetectedUsbtmcDevicesBox" Grid.Column="1" ItemsSource="{Binding UsbtmcDeviceOptions}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedUsbtmcDevice}" />
                        </Grid>
                        <!-- Same hint as the TUI's usbNotFoundLabel, for HID and USBTMC alike. -->
                        <TextBlock x:Name="UsbDeviceNotFoundText" Margin="140,0,0,4" Foreground="DarkRed" TextWrapping="Wrap"
                                   Text="(not found — no connected device matches this vendor/product/serial)"
                                   Visibility="{Binding ConnectedDeviceNotFound, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <StackPanel x:Name="BlePanel" Visibility="{Binding IsBleTransport, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="BLE" FontWeight="Bold" Margin="0,8,0,2" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="BLE device ID:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding BleDeviceId, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Service UUID:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding BleServiceUuid, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Write characteristic UUID:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding BleWriteCharacteristicUuid, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Notify characteristic UUID:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding BleNotifyCharacteristicUuid, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="LoopbackPanel" Visibility="{Binding IsLoopbackTransport, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Loopback" FontWeight="Bold" Margin="0,8,0,2" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="No configuration needed — a scripted fake device. Try &quot;hello&quot;, &quot;Send Stream: N, ascii&quot;, &quot;Send Events: N&quot;, or &quot;help&quot;/&quot;?&quot;." />
                    </StackPanel>

                    <TextBlock Text="Presentation" FontWeight="Bold" Margin="0,8,0,2" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Presenters:" VerticalAlignment="Center" />
                        <ItemsControl x:Name="PresenterChoicesList" Grid.Column="1" ItemsSource="{Binding PresenterChoices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,2,12,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <Grid Margin="0,0,0,4" Visibility="{Binding IsScpiPresenterSelected, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SCPI profile:" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ScpiProfileOptions}" SelectedItem="{Binding ScpiProfile}" />
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Send as:" VerticalAlignment="Center" />
                        <ComboBox x:Name="ParserBox" Grid.Column="1" ItemsSource="{Binding PresenterOptions}" SelectedItem="{Binding Parser}" />
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Line ending:" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding LineEndingOptions}" SelectedItem="{Binding LineEndingText}" />
                    </Grid>

                    <DockPanel Margin="0,12,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="Save as profile named:" Margin="0,0,0,4" />
                        <Button DockPanel.Dock="Right" Content="Save Profile" Padding="8,2" Command="{Binding SaveCommand}" />
                        <TextBox Margin="0,0,8,0" Text="{Binding SaveName, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <DockPanel Margin="0,12,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="Import/export file path:" Margin="0,0,0,4" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Browse..." Padding="8,2" Margin="0,0,4,0" Click="Browse_Click" />
                            <Button Content="Save As..." Padding="8,2" Click="SaveAs_Click" />
                        </StackPanel>
                        <TextBox Margin="0,0,8,0" Text="{Binding ImportExportPath, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button Content="Import" Padding="8,2" Margin="0,0,8,0" Command="{Binding ImportCommand}" />
                        <Button Content="Replace All" Padding="8,2" Margin="0,0,8,0" Command="{Binding ReplaceAllFromZipCommand}"
                                ToolTip="Delete every saved profile, then import every profile in the .zip" />
                        <Button Content="Export" Padding="8,2" Command="{Binding ExportCommand}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
