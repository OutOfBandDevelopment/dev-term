<Window x:Class="DevTerm.Wpf.DeviceProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dev-term — Device Profiles" Height="640" Width="480" MinHeight="520" MinWidth="420"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <!-- Collapsed while there's no message, so an empty status line doesn't leave a blank band across the top. -->
        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource DevTerm.Error}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Connect" MinWidth="80" Height="32" Padding="12,0" Margin="0,0,8,0" IsDefault="True" Command="{Binding ConnectCommand}" />
            <Button Content="Close" MinWidth="80" Height="32" Padding="12,0" IsCancel="True" />
        </StackPanel>

        <!-- Two proportional rows (not fixed heights) so both the saved-profiles list and the
             field editor below it grow/shrink together as the window is resized. The first row's
             minimum is the height of its button column ("Saved profiles:" plus six buttons) - it was
             90, which cut Refresh/Export Selected/Export All off at the window's minimum size. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" MinHeight="190" />
                <RowDefinition Height="2*" MinHeight="160" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Top" Text="Saved profiles:" Margin="0,0,0,4" />
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top">
                    <Button Content="Load" Padding="8,2" Margin="0,0,0,4" Command="{Binding LoadCommand}" />
                    <Button Content="Delete" Padding="8,2" Margin="0,0,0,4" Command="{Binding DeleteCommand}" />
                    <Button Content="Delete Selected" Padding="8,2" Margin="0,0,0,4" Command="{Binding DeleteSelectedProfilesCommand}" />
                    <Button Content="Refresh" Padding="8,2" Margin="0,0,0,4" Command="{Binding RefreshCommand}" />
                    <Button Content="Export Selected" Padding="8,2" Margin="0,0,0,4" Command="{Binding ExportSelectedProfilesCommand}" />
                    <Button Content="Export All" Padding="8,2" Command="{Binding ExportAllProfilesCommand}" />
                </StackPanel>
                <!-- SelectionMode="Extended" (ctrl/shift-click, like Explorer) is what "Export Selected"
                     needs - ListBox.SelectedItems has no dependency property of its own to bind
                     two-way in pure XAML, so SelectionChanged pushes it into the view model's
                     SelectedProfileNames from code-behind instead (see DeviceProfilesWindow.xaml.cs).
                     SelectedItem stays bound as before - Load/Delete only ever act on one profile;
                     Export Selected/Delete Selected act on the whole multi-selection.
                     Double-click is the ListBox's own MouseDoubleClick event (Control raises it on
                     every control under the pointer), with the row found from the click's source -
                     not a MouseBinding (ListBoxItem marks the mouse-down handled, so an InputBinding
                     never sees the second click), and not an ItemContainerStyle EventSetter either: a
                     local item style replaces the theme's (DarkControls) ListBoxItem style, which left
                     this one list with the stock light selection frame under a dark theme. -->
                <ListBox x:Name="ProfilesList" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfileName}"
                         SelectionMode="Extended" SelectionChanged="ProfilesList_SelectionChanged" Margin="0,0,8,0"
                         MouseDoubleClick="ProfilesList_MouseDoubleClick" />
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- The connection fields: generated from ConnectionEditorViewModel's annotated
                         properties (ConnectionEditorViewModel.FormDefinition) and rendered by the
                         generic FormRenderer in code-behind - the same definition the TUI's
                         ConfigureMode renders. The detected-device pickers are the only hand-built
                         widgets inside it (see DeviceProfilesWindow.xaml.cs). -->
                    <ContentControl x:Name="ConnectionFormHost" Focusable="False" IsTabStop="False" />

                    <DockPanel Margin="0,12,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="Save as profile named:" Margin="0,0,0,4" />
                        <Button DockPanel.Dock="Right" Content="Save Profile" Padding="8,2" Command="{Binding SaveCommand}" />
                        <TextBox Margin="0,0,8,0" Text="{Binding SaveName, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <DockPanel Margin="0,12,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="Import/export file path:" Margin="0,0,0,4" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Browse..." Padding="8,2" Margin="0,0,4,0" Click="Browse_Click" />
                            <Button Content="Save As..." Padding="8,2" Click="SaveAs_Click" />
                        </StackPanel>
                        <TextBox Margin="0,0,8,0" Text="{Binding ImportExportPath, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button Content="Import" Padding="8,2" Margin="0,0,8,0" Command="{Binding ImportCommand}" />
                        <Button Content="Replace All" Padding="8,2" Margin="0,0,8,0" Command="{Binding ReplaceAllFromZipCommand}"
                                ToolTip="Delete every saved profile, then import every profile in the .zip" />
                        <Button Content="Export" Padding="8,2" Command="{Binding ExportCommand}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
