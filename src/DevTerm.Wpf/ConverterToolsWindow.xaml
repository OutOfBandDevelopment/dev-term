<Window x:Class="DevTerm.Wpf.ConverterToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dev-term — Converter tools" Height="420" Width="640" MinHeight="360" MinWidth="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Tools the Stream Monitor can run on a capture. Auto picks the first tool, in this order, whose formats match." />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,6,0,0">
                    <Button x:Name="AddButton" Content="Add" Margin="0,0,3,3" Click="Add_Click" />
                    <Button x:Name="RemoveButton" Content="Remove" Margin="3,0,0,3" Click="Remove_Click" />
                    <Button x:Name="UpButton" Content="Move up" Margin="0,0,3,0" Click="Up_Click" />
                    <Button x:Name="DownButton" Content="Move down" Margin="3,0,0,0" Click="Down_Click" />
                </UniformGrid>
                <ListBox x:Name="ToolList" SelectionChanged="ToolList_SelectionChanged" />
            </DockPanel>
            <Grid x:Name="DetailGrid" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Name" VerticalAlignment="Center" Margin="0,0,8,6" />
                <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" TextChanged="Field_TextChanged" ToolTip="Shown in the conversion list; used as tool:Name" />
                <TextBlock Grid.Row="1" Text="Path" VerticalAlignment="Center" Margin="0,0,8,6" />
                <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="Browse..." Padding="8,1" Margin="4,0,0,0" Click="Browse_Click" />
                    <TextBox x:Name="PathBox" TextChanged="Field_TextChanged" ToolTip="The converter's executable" />
                </DockPanel>
                <TextBlock Grid.Row="2" Text="Arguments" VerticalAlignment="Center" Margin="0,0,8,6" />
                <TextBox x:Name="ArgumentsBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" TextChanged="Field_TextChanged" ToolTip="Split on spaces; {input}, {output} and {dpi} are substituted" />
                <TextBlock Grid.Row="3" Text="Formats" VerticalAlignment="Center" Margin="0,0,8,6" />
                <TextBox x:Name="FormatsBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" TextChanged="Field_TextChanged" ToolTip="ps, pcl, hpgl, image or an extension such as bmp, comma-separated; empty means any" />
                <TextBlock Grid.Row="4" Text="Output extension" VerticalAlignment="Center" Margin="0,0,8,6" />
                <TextBox x:Name="ExtensionBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,6" TextChanged="Field_TextChanged" ToolTip="Extension (no dot) of the file the tool writes" />
                <TextBlock Grid.Row="5" Text="DPI" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="DpiBox" Grid.Row="5" Grid.Column="1" TextChanged="Field_TextChanged" ToolTip="The value substituted for {dpi}" />
            </Grid>
        </Grid>
        <TextBlock x:Name="ErrorText" Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap" MinHeight="18" Foreground="#C0392B" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="OkButton" Content="OK" Width="80" Height="30" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
            <Button Content="Cancel" Width="80" Height="30" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
