<Window x:Class="DevTerm.Wpf.ThemeBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dev-term — Theme Builder" Height="560" Width="620" MinHeight="440" MinWidth="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Name:" VerticalAlignment="Center" />
            <TextBox x:Name="NameBox" Width="220" Margin="6,0,16,0" VerticalContentAlignment="Center" TextChanged="NameBox_TextChanged" />
            <TextBlock Text="Chart palette:" VerticalAlignment="Center" />
            <ComboBox x:Name="PaletteBox" Width="90" Margin="6,0,0,0" VerticalContentAlignment="Center" SelectionChanged="PaletteBox_SelectionChanged">
                <ComboBoxItem Content="Light" />
                <ComboBoxItem Content="Dark" />
            </ComboBox>
        </StackPanel>

        <TextBlock Grid.Row="1" Margin="0,10,0,4"
                   Text="Colors (double-click or Edit... to change; ● marks one overridden from the seed):" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="RolesList" Grid.Column="0" FontFamily="Consolas" DisplayMemberPath="Row" MouseDoubleClick="RolesList_MouseDoubleClick" />
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <Button x:Name="EditButton" Content="Edit..." Width="110" Margin="0,0,0,6" Click="EditButton_Click" />
                <Button x:Name="ResetButton" Content="Reset to Seed" Width="110" Click="ResetButton_Click" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="WarningsText" Grid.Row="3" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource DevTerm.Warning}" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="SaveButton" Content="Save" Width="80" Height="32" Margin="0,0,8,0" IsDefault="True" Click="SaveButton_Click" />
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="32" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
