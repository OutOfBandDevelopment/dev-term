<Window x:Class="DevTerm.Wpf.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dev-term — Control Panel" Height="640" Width="560" MinHeight="300" MinWidth="360">
    <DockPanel Margin="8">
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource DevTerm.Error}" />
        <!-- Scrolls sideways too: a section's aligned label column plus its widest control can be
             wider than the window at its minimum width. The Notes text wraps to the visible width
             (ControlPanelWindow.xaml.cs). -->
        <ScrollViewer x:Name="SectionsScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel x:Name="SectionsPanel" />
        </ScrollViewer>
    </DockPanel>
</Window>
