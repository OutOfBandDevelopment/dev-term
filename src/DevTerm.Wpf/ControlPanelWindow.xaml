<Window x:Class="DevTerm.Wpf.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dev-term — Control Panel" Height="600" Width="480" MinHeight="300" MinWidth="360">
    <DockPanel Margin="8">
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="DarkRed" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SectionsPanel" />
        </ScrollViewer>
    </DockPanel>
</Window>
