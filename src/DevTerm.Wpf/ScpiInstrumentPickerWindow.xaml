<Window x:Class="DevTerm.Wpf.ScpiInstrumentPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dev-term — Select SCPI Instrument" Height="380" Width="560" MinHeight="240" MinWidth="280"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Select" Width="80" Height="32" Margin="0,0,8,0" IsDefault="True" Click="SelectButton_Click" />
            <Button Content="Cancel" Width="80" Height="32" IsCancel="True" />
        </StackPanel>
        <ListBox x:Name="ProfileList" MouseDoubleClick="ProfileList_MouseDoubleClick" />
    </DockPanel>
</Window>
