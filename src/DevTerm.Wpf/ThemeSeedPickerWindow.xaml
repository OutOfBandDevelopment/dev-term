<Window x:Class="DevTerm.Wpf.ThemeSeedPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dev-term — Build/Edit Theme" Height="420" Width="420" MinHeight="320" MinWidth="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="80" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Start from:" />
        <ListBox x:Name="SeedList" Grid.Row="1" Margin="0,4,0,0" DisplayMemberPath="Label" MouseDoubleClick="SeedList_MouseDoubleClick" />
        <TextBlock Grid.Row="2" Margin="0,8,0,0" Text="New theme name:" />
        <TextBox x:Name="NameBox" Grid.Row="3" Margin="0,4,0,0" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CreateButton" Content="Create" Width="80" Height="32" Margin="0,0,8,0" IsDefault="True" Click="CreateButton_Click" />
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="32" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
