<Window x:Class="DevTerm.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DevTerm.Wpf"
        mc:Ignorable="d"
        Title="dev-term" Height="480" Width="720">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Device Profiles..." Click="DeviceProfiles_Click" />
                <Separator />
                <MenuItem Header="E_xit" InputGestureText="Ctrl+Q" Click="Exit_Click" />
            </MenuItem>
        </Menu>
        <DockPanel Margin="8">
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="Send" Padding="16,0" Margin="8,0,0,0"
                        IsDefault="True" Click="Send_Click" />
                <TextBox x:Name="SendBox" VerticalContentAlignment="Center" KeyDown="SendBox_KeyDown" />
            </DockPanel>
            <ListBox x:Name="OutputList" FontFamily="Consolas" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </DockPanel>
    </DockPanel>
</Window>
