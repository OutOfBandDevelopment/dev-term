<Window x:Class="DevTerm.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DevTerm.Wpf"
        mc:Ignorable="d"
        Title="dev-term" Height="480" Width="720" MinHeight="300" MinWidth="480">
    <Window.Resources>
        <!-- Applied to each session tab's own output ListBox, built in code-behind
             (MainWindow.xaml.cs's CreateWindowTab) - one per SessionTab, not a single window-level
             control, so each tab keeps its own scrollback. Items are OutputLine records: device
             output in the normal color, app status lines dimmed and italic, errors in the error
             color (theme roles OutputStatus/OutputError, WpfTheme) - so they can't be mistaken for
             each other. -->
        <DataTemplate x:Key="OutputLineTemplate" DataType="{x:Type local:OutputLine}">
            <TextBlock x:Name="LineText" Text="{Binding Text}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:OutputKind.Status}">
                    <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource DevTerm.OutputStatus}" />
                    <Setter TargetName="LineText" Property="FontStyle" Value="Italic" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:OutputKind.Error}">
                    <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource DevTerm.OutputError}" />
                    <Setter TargetName="LineText" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:OutputKind.Sent}">
                    <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource DevTerm.Accent}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem x:Name="ConnectMenuItem" Header="_Disconnect" Click="ConnectMenuItem_Click" />
                <MenuItem x:Name="DeviceProfilesMenuItem" Header="_Device Profiles..." Click="DeviceProfiles_Click" />
                <Separator />
                <MenuItem Header="_New Session..." InputGestureText="Ctrl+T" Click="NewSession_Click" />
                <MenuItem x:Name="CloseSessionMenuItem" Header="_Close Session" InputGestureText="Ctrl+W" Click="CloseSession_Click" />
                <Separator />
                <!-- Logger mode and playback: MainWindow.Logging.cs. -->
                <MenuItem x:Name="LoggingMenuItem" Header="Start _Logging..." Click="LoggingMenuItem_Click" />
                <MenuItem Header="Open Log for _Playback..." Click="OpenLogForPlayback_Click" />
                <Separator />
                <MenuItem Header="E_xit" InputGestureText="Ctrl+Q" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Device">
                <MenuItem x:Name="ScpiMenuItem" Header="_SCPI Instrument..." Click="ScpiInstrument_Click" />
                <MenuItem x:Name="ManifestMenuItem" Header="Device _Manifest..." Click="DeviceManifest_Click" />
                <MenuItem Header="_Edit Device Manifest..." Click="EditDeviceManifest_Click" />
                <Separator />
                <MenuItem x:Name="StreamMonitorMenuItem" Header="S_tream Monitor..." Click="StreamMonitor_Click" />
                <MenuItem x:Name="RoutingMenuItem" Header="_Routing..." Click="Routing_Click" />
                <MenuItem x:Name="ConverterToolsMenuItem" Header="Converter _Tools..." Click="ConverterTools_Click" />
                <MenuItem x:Name="PluginsMenuItem" Header="_Plugins..." Click="Plugins_Click" />
            </MenuItem>
            <!-- View > Theme: one checkable item per theme, built in MainWindow.Theme.cs. -->
            <MenuItem Header="_View">
                <MenuItem x:Name="ThemeMenuItem" Header="_Theme" />
                <MenuItem x:Name="MergedLogMenuItem" Header="_All Sessions Log..." Click="MergedLog_Click" />
                <MenuItem x:Name="BuildEditThemeMenuItem" Header="_Build/Edit Theme..." Click="BuildEditTheme_Click" />
                <MenuItem x:Name="EchoSentCommandsMenuItem" Header="_Echo Sent Commands" IsCheckable="True" Click="EchoSentCommandsMenuItem_Click" />
                <!-- Only meaningful for a TCP transport; RefreshConnectionUi enables/disables and
                     checks/unchecks this per the active tab (MainWindow.FlowControl.cs). -->
                <MenuItem x:Name="SoftwareFlowControlMenuItem" Header="_Software Flow Control (XON/XOFF)" IsCheckable="True" Click="SoftwareFlowControlMenuItem_Click" />
                <Separator />
                <MenuItem x:Name="ClearOutputMenuItem" Header="Clea_r Output" Click="ClearOutputMenuItem_Click" />
            </MenuItem>
        </Menu>
        <!-- Connection-state indicator (MainWindow.RefreshConnectionUi): a colored dot plus
             "Connected — tcp://…" / "Connecting — …" / "Disconnected — …". -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="ConnectionStatusDot" Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource DevTerm.StatusDisconnected}" />
                    <TextBlock x:Name="ConnectionStatusText" VerticalAlignment="Center" />
                </StackPanel>
            </StatusBarItem>
            <!-- "● REC capture.jsonl" while logging (MainWindow.Logging.cs). -->
            <StatusBarItem>
                <TextBlock x:Name="LoggingStatusText" Foreground="{DynamicResource DevTerm.Recording}" FontWeight="SemiBold" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
            <!-- "Broker: Connected" while the profile has routing rules (MainWindow.RefreshRoutingStatus). -->
            <StatusBarItem x:Name="RoutingStatusItem" Visibility="Collapsed">
                <TextBlock x:Name="RoutingStatusText" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>
        <DockPanel Margin="8">
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="Send" Padding="16,0" Margin="8,0,0,0"
                        IsDefault="True" Click="Send_Click" />
                <ComboBox x:Name="ParserBox" DockPanel.Dock="Right" Width="90" Margin="8,0,0,0"
                          ToolTip="Send as: how the typed line is turned into bytes (applies from the next line sent)"
                          SelectionChanged="ParserBox_SelectionChanged" />
                <TextBlock DockPanel.Dock="Right" Text="Send as:" VerticalAlignment="Center" Margin="8,0,0,0" />
                <ComboBox x:Name="SendBox" IsEditable="True" IsTextSearchEnabled="False"
                          VerticalContentAlignment="Center" PreviewKeyDown="SendBox_PreviewKeyDown" />
            </DockPanel>
            <!-- One TabItem per open SessionTab, built in code-behind (MainWindow.xaml.cs's
                 CreateWindowTab) - see docs/design/multi-session-ui.md. Starts with exactly one tab,
                 same as before multi-session support; File > New Session adds another. -->
            <TabControl x:Name="SessionTabs" SelectionChanged="SessionTabs_SelectionChanged" />
        </DockPanel>
    </DockPanel>
</Window>
