<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DevTerm.Configuration\DevTerm.Configuration.csproj" />
    <ProjectReference Include="..\DevTerm.Devices.K8055\DevTerm.Devices.K8055.csproj" />
    <ProjectReference Include="..\DevTerm.UiDefinitions\DevTerm.UiDefinitions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Share the console app's saved connection profile (untracked, personal — see .gitignore)
         so it works the same from either front end, per docs/design/frontends.md. -->
    <None Include="..\DevTerm.Console\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\DevTerm.Console\appsettings.json')" />
    <None Include="..\DevTerm.Console\appsettings.Local.json" Link="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\DevTerm.Console\appsettings.Local.json')" />
  </ItemGroup>

</Project>
