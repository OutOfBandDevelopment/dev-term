<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DevTerm.DeviceManifests\DevTerm.DeviceManifests.csproj" />
    <ProjectReference Include="..\DevTerm.UiDefinitions\DevTerm.UiDefinitions.csproj" />
    <ProjectReference Include="..\DevTerm.Configuration\DevTerm.Configuration.csproj" />
  </ItemGroup>

  <!-- Regenerates <repo>/schemas on every Debug build, so the committed files are the build's output, never hand-edited.
       SchemaDriftTests fails if what is committed differs from what the model generates. -->
  <Target Name="GenerateSchemas" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <Exec Command="dotnet &quot;$(TargetPath)&quot; &quot;$(MSBuildThisFileDirectory)..\..\schemas&quot;" />
  </Target>

</Project>
