<Project Sdk="Microsoft.NET.Sdk">

  <!-- Opt-in OpenTelemetry export of DevTerm.Core's ActivitySource/Meter over OTLP. Nothing references this
       except DevTerm.Configuration, and it only does anything when the otlp option is given. See docs/design/observability.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DevTerm.Core\DevTerm.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DevTerm.Observability.Tests" />
  </ItemGroup>

</Project>
