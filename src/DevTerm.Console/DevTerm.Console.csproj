<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DevTerm.Core\DevTerm.Core.csproj" />
    <ProjectReference Include="..\DevTerm.Transports.Serial\DevTerm.Transports.Serial.csproj" />
    <ProjectReference Include="..\DevTerm.Presenters.Text\DevTerm.Presenters.Text.csproj" />
    <ProjectReference Include="..\DevTerm.Transports.Tcp\DevTerm.Transports.Tcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- appsettings.Local.json is a personal, untracked saved profile (see .gitignore) — copy it
         to the output directory if present so it survives rebuilds, same as appsettings.json. -->
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('appsettings.json')" />
    <None Include="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('appsettings.Local.json')" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
