@page "/connections"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@inject ConnectionManager Manager
@inject PersistentComponentState PersistedState
@implements IDisposable

<h2>Connections</h2>
@if (_readOnly) { <p class="note">Read-only viewer: connections cannot be opened or closed.</p> }
@if (_error is not null) { <p class="error">@_error</p> }

@if (_project.Count == 0)
{
    <p class="note">No saved connections yet; add one on the Profiles page.</p>
}
else
{
    <fieldset>
        <legend>Project</legend>
        @foreach (var c in _project)
        {
            <div class="row" data-project="@c.Name">
                <label>@c.Name</label>
                <span class="note">@c.Description</span>
                <button disabled="@_readOnly" @onclick="() => OpenAsync(c.Name)">Open</button>
            </div>
        }
    </fieldset>
}

<fieldset>
    <legend>Project file</legend>
    <p class="note">Save the open connections (or, with none open, the saved ones) as a dev-term project file, or add a project file's connections to this host's. The file includes credentials, so only a viewer with write access gets it.</p>
    @if (_readOnly)
    {
        <p class="note" data-projectfile-readonly>Project files are not available with a read-only token.</p>
    }
    else
    {
        <div class="row">
            <a data-exportproject href="api/project/export?name=project" download="project.json">Save project</a>
        </div>
        <div class="row">
            <label>Open project file <InputFile data-importfile OnChange="LoadFileAsync" accept=".json" /></label>
        </div>
        <div class="row">
            <textarea data-importtext rows="6" placeholder="Paste a project file here" @bind="_importText" @bind:event="oninput"></textarea>
        </div>
        <div class="row">
            <label><input data-importopen type="checkbox" @bind="_importOpen" /> Open the connections after importing</label>
            <button data-import disabled="@string.IsNullOrWhiteSpace(_importText)" @onclick="ImportAsync">Open project</button>
        </div>
    }
    @if (_importMessage is not null) { <p class="@(_importFailed ? "error" : "note")" data-importresult>@_importMessage</p> }
</fieldset>

<fieldset>
    <legend>Open</legend>
    @if (_open.Count == 0) { <p class="note">None open.</p> }
    @foreach (var c in _open)
    {
        <div class="row" data-open="@c.Id">
            <label>@c.Name</label>
            <span class="note">@c.State - /ws/@c.Id</span>
            <button disabled="@_readOnly" @onclick="() => CloseAsync(c.Id)">Close</button>
        </div>
    }
</fieldset>

@code {
    private PersistingComponentStateSubscription _subscription;
    private bool _readOnly;
    private string? _error;
    private string _importText = string.Empty;
    private bool _importOpen = true;
    private bool _importFailed;
    private string? _importMessage;
    private IReadOnlyList<(string Name, string Description)> _project = [];
    private IReadOnlyList<(string Id, string Name, string State)> _open = [];
    private CancellationTokenSource? _cts;

    [CascadingParameter] private HttpContext? Http { get; set; }

    protected override void OnInitialized()
    {
        if (Http is not null)
        {
            _readOnly = Http.Items.ContainsKey(AccessTokenMiddleware.ReadOnlyItem);
            _subscription = PersistedState.RegisterOnPersisting(() =>
            {
                PersistedState.PersistAsJson("readOnly", _readOnly);
                return Task.CompletedTask;
            });
        }
        else
        {
            _readOnly = !PersistedState.TryTakeFromJson<bool>("readOnly", out var persisted) || persisted; // unknown means no controls
        }

        Refresh();
    }

    private void Refresh()
    {
        _project = Manager.Project();
        _open = Manager.Open();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && Http is null)
        {
            _cts = new CancellationTokenSource();
            _ = WatchAsync(_cts.Token);
        }
    }

    // Re-read when any connection opens or closes (from this page, the REST API or another tab).
    private async Task WatchAsync(CancellationToken token)
    {
        try
        {
            await foreach (var frame in Manager.Events.SubscribeAsync(token))
            {
                if (frame.StartsWith("event: connection-", StringComparison.Ordinal))
                {
                    Refresh();
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task OpenAsync(string name)
    {
        if (_readOnly)
        {
            return;
        }

        try
        {
            _error = await Manager.OpenAsync(name) is null ? $"No project connection named '{name}'." : null;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _error = ex.Message;
        }

        Refresh();
    }

    private async Task LoadFileAsync(InputFileChangeEventArgs e)
    {
        if (_readOnly)
        {
            return;
        }

        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(1024 * 1024));
            _importText = await reader.ReadToEndAsync();
            _importMessage = null;
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException)
        {
            _importFailed = true;
            _importMessage = "The file could not be read: " + ex.Message;
        }
    }

    private async Task ImportAsync()
    {
        if (_readOnly)
        {
            return;
        }

        var (imported, errors) = Manager.ImportProject(_importText);
        var opened = 0;
        if (_importOpen)
        {
            foreach (var name in imported)
            {
                try
                {
                    if (await Manager.OpenAsync(name) is not null)
                    {
                        opened++;
                    }
                }
                catch (Exception ex) when (ex is not OperationCanceledException)
                {
                    errors = [.. errors, $"{name}: {ex.Message}"];
                }
            }
        }

        _importFailed = imported.Count == 0;
        _importMessage = $"Imported {imported.Count} connection(s)" + (_importOpen ? $", opened {opened}" : string.Empty) + "."
            + (errors.Count > 0 ? " Problems: " + string.Join("; ", errors) : string.Empty);
        Refresh();
    }

    private async Task CloseAsync(string id)
    {
        if (_readOnly)
        {
            return;
        }

        await Manager.CloseAsync(id);
        Refresh();
    }

    public void Dispose()
    {
        _subscription.Dispose();
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
