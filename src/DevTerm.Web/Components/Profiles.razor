@page "/profiles"
@using DevTerm.Configuration
@using DevTerm.Configuration.Discovery
@using DevTerm.UiDefinitions
@using DevTerm.UiDefinitions.Forms
@using Microsoft.AspNetCore.Components.Web
@using DevTerm.Core.Control
@inject ConnectionManager Manager
@inject IEnumerable<IDeviceConfigEditor> ConfigEditors
@inject PersistentComponentState PersistedState
@implements IDisposable

<h2>Profiles</h2>
@if (_readOnly) { <p class="note">Read-only viewer: profiles cannot be changed.</p> }
@if (!Manager.HasProject) { <p class="note">Nothing to edit.</p> }
@if (_error is not null) { <p class="error" data-error="page">@_error</p> }

@if (_vm is null)
{
    <fieldset>
        <legend>Project connections</legend>
        @foreach (var c in _project)
        {
            <div class="row" data-project="@c.Name">
                <label>@c.Name</label>
                <span class="note">@c.Description</span>
                <button disabled="@_readOnly" @onclick="() => Edit(c.Name)">Edit</button>
                <button disabled="@_readOnly" @onclick="() => OpenAsync(c.Name)">Open</button>
                @if (_confirmDelete == c.Name)
                {
                    <button disabled="@_readOnly" @onclick="() => Delete(c.Name)">Really delete?</button>
                }
                else
                {
                    <button disabled="@_readOnly" @onclick="() => _confirmDelete = c.Name">Delete</button>
                }
            </div>
        }
        @if (_project.Count == 0) { <p class="note">No connections yet.</p> }
        <div class="row"><button id="new" disabled="@(_readOnly || !Manager.HasProject)" @onclick="New">New connection...</button></div>
    </fieldset>
}
else
{
    <fieldset>
        <legend>@(_isNew ? "New connection" : "Edit " + _name)</legend>
        <div class="row">
            <label>Name</label>
            <input type="text" data-field="Name" value="@_name" disabled="@(!_isNew)" @onchange="e => _name = e.Value?.ToString() ?? string.Empty" />
        </div>
        <div class="row">
            <button id="detect" @onclick="DetectAsync" disabled="@_detecting">@(_detecting ? "Detecting..." : "Detect network devices...")</button>
            @foreach (var hit in _hits)
            {
                <button data-hit="@hit.Address" @onclick="() => Prefill(hit)">@hit.Display</button>
            }
            @if (_detected && _hits.Count == 0) { <span class="note">No network devices answered.</span> }
        </div>
        @foreach (var section in _form!.Sections)
        {
            if (!_binding!.IsVisible(section.VisibleWhen) || !section.Controls.Any(Shown)) { continue; }
            <fieldset>
                @if (!string.IsNullOrEmpty(section.Label)) { <legend>@section.Label</legend> }
                @foreach (var c in section.Controls.Where(Shown))
                {
                    <div class="row" data-field="@c.Id" title="@c.Description">
                        <label>@c.Label</label>
                        @switch (c)
                        {
                            case ChoiceControl { Style: ChoiceStyle.CheckList } list:
                                @foreach (var option in list.Options)
                                {
                                    <label><input type="checkbox" checked="@_binding.GetSelection(list.Id).Contains(option)" @onchange="e => Toggle(list, option, e.Value)" /> @option</label>
                                }
                                break;
                            case ChoiceControl choice:
                                <select @onchange="e => Set(choice, e.Value?.ToString())">
                                    @foreach (var option in choice.Options)
                                    {
                                        <option value="@option" selected="@(option == _binding.GetText(choice.Id))">@option</option>
                                    }
                                </select>
                                break;
                            case ToggleControl toggle:
                                <input type="checkbox" checked="@_binding.GetBool(toggle.Id)" @onchange="e => SetBool(toggle, e.Value)" />
                                break;
                            default:
                                <input type="text" value="@_binding.GetText(c.Id)" @onchange="e => Set(c, e.Value?.ToString())" />
                                break;
                        }
                        @if (_fieldErrors.TryGetValue(c.Id, out var fieldError)) { <span class="error">@fieldError</span> }
                    </div>
                }
            </fieldset>
        }
        @if (ConfigEditors.Any())
        {
            <fieldset id="configure">
                <legend>Configure device</legend>
                <div class="row">
                    <label>Editor</label>
                    <select id="cfg-editor" @onchange="e => PickEditor(e.Value?.ToString())">
                        <option value="">(choose)</option>
                        @foreach (var editor in ConfigEditors)
                        {
                            <option value="@editor.Id" selected="@(editor.Id == _cfgEditor?.Id)">@editor.Title</option>
                        }
                    </select>
                    <button id="cfg-read" disabled="@(_cfgEditor is null || _cfgBusy)" @onclick="ReadConfigAsync">Read from device</button>
                    <span class="note">Talks to @_vm.Host : @_vm.Port</span>
                </div>
                @if (_cfgMessage is not null) { <p class="note" data-cfg-message>@_cfgMessage</p> }
                @if (_cfgSession is { HasRead: true } cfg)
                {
                    @foreach (var c in _cfgEditor!.BuildDefinition().Sections.SelectMany(sec => sec.Controls).Where(c => c is not ButtonControl))
                    {
                        <div class="row" data-cfg="@c.Id" title="@c.Description">
                            <label>@c.Label</label>
                            @switch (c)
                            {
                                case ChoiceControl choice:
                                    <select @onchange="e => cfg.Set(choice.Id, e.Value?.ToString() ?? string.Empty)">
                                        @foreach (var option in choice.Options)
                                        {
                                            <option value="@option" selected="@(option == cfg.Values.GetValueOrDefault(choice.Id))">@option</option>
                                        }
                                    </select>
                                    break;
                                case ToggleControl:
                                    <input type="checkbox" checked="@CfgOn(cfg, c.Id)" @onchange="e => CfgSetBool(cfg, c.Id, e.Value)" />
                                    break;
                                default:
                                    <input type="text" value="@cfg.Values.GetValueOrDefault(c.Id)" @onchange="e => cfg.Set(c.Id, e.Value?.ToString() ?? string.Empty)" />
                                    break;
                            }
                        </div>
                    }
                    @foreach (var change in cfg.Changes())
                    {
                        <div class="note" data-cfg-change="@change.FieldId">@change.FieldId: @change.From to @change.To</div>
                    }
                    @foreach (var issue in cfg.Validate())
                    {
                        <div class="error" data-cfg-issue="@issue.FieldId">@issue.FieldId: @issue.Message</div>
                    }
                    @if (cfg.WillDropConnection()) { <p class="error" data-cfg-drop>Writing these values changes the address this page is talking to, so the connection will drop.</p> }
                    <div class="row"><button id="cfg-write" disabled="@(_readOnly || _cfgBusy || cfg.Changes().Count == 0 || cfg.Validate().Count > 0)" @onclick="WriteConfigAsync">Write to device</button></div>
                }
            </fieldset>
        }
        <div class="row">
            <button id="save" disabled="@_readOnly" @onclick="Save">Save</button>
            <button id="cancel" @onclick="Cancel">Cancel</button>
        </div>
    </fieldset>
}

@code {
    private PersistingComponentStateSubscription _subscription;
    private bool _readOnly;
    private string? _error;
    private IReadOnlyList<(string Name, string Description)> _project = [];
    private string? _confirmDelete;
    private ConnectionEditorViewModel? _vm;
    private FormBinding? _binding;
    private UiDefinition? _form;
    private string _name = string.Empty;
    private bool _isNew;
    private bool _detecting;
    private bool _detected;
    private IReadOnlyList<NetworkDeviceHit> _hits = [];
    private readonly Dictionary<string, string> _fieldErrors = [];

    private IDeviceConfigEditor? _cfgEditor;
    private DeviceConfigSession? _cfgSession;
    private string? _cfgMessage;
    private bool _cfgBusy;

    private static bool CfgOn(DeviceConfigSession cfg, string id) => cfg.Values.GetValueOrDefault(id) is "true" or "True" or "1";

    private static void CfgSetBool(DeviceConfigSession cfg, string id, object? value) => cfg.Set(id, value is true ? "true" : "false");

    private void PickEditor(string? id)
    {
        _cfgEditor = ConfigEditors.FirstOrDefault(e => e.Id == id);
        _cfgSession = null;
        _cfgMessage = null;
    }

    private DeviceConfigTarget CfgTarget() => new(_vm!.Host ?? string.Empty, int.TryParse(_vm.Port, out var port) ? port : 0);

    private async Task ReadConfigAsync()
    {
        _cfgBusy = true;
        try
        {
            var session = new DeviceConfigSession(_cfgEditor!, CfgTarget());
            await session.ReadAsync();
            _cfgSession = session;
            _cfgMessage = "Read the device's current settings.";
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _cfgSession = null;
            _cfgMessage = "Could not read the device: " + ex.Message;
        }

        _cfgBusy = false;
    }

    private async Task WriteConfigAsync()
    {
        if (_readOnly || _cfgSession is null)
        {
            return;
        }

        _cfgBusy = true;
        try
        {
            var mismatches = await _cfgSession.WriteAsync();
            _cfgMessage = mismatches.Count == 0
                ? "Written; the device confirmed every value." + (_cfgSession.RebootRequired ? " Restart the device for the change to apply." : string.Empty)
                : "Written, but the device read back different values for: " + string.Join(", ", mismatches.Select(m => m.FieldId));
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _cfgMessage = "Could not write the device: " + ex.Message;
        }

        _cfgBusy = false;
    }

    [CascadingParameter] private HttpContext? Http { get; set; }

    protected override void OnInitialized()
    {
        if (Http is not null)
        {
            _readOnly = Http.Items.ContainsKey(AccessTokenMiddleware.ReadOnlyItem);
            _subscription = PersistedState.RegisterOnPersisting(() =>
            {
                PersistedState.PersistAsJson("readOnly", _readOnly);
                return Task.CompletedTask;
            });
        }
        else
        {
            _readOnly = !PersistedState.TryTakeFromJson<bool>("readOnly", out var persisted) || persisted; // unknown means no controls
        }

        _project = Manager.Project();
    }

    // Buttons and the rich device pickers (Selected*) are not plain values; the form shows the editable settings only.
    private bool Shown(UiControl c) => c is not ButtonControl && !c.Id.StartsWith("Selected", StringComparison.Ordinal) && _binding!.Has(c.Id) && _binding.IsVisible(c.VisibleWhen);

    private void Begin(CliOptions options, string name, bool isNew)
    {
        _binding?.Dispose();
        _vm = new ConnectionEditorViewModel(new ConnectionProfileStore(), options);
        _binding = new FormBinding(_vm);
        _form = _vm.FormDefinition;
        _name = name;
        _isNew = isNew;
        _hits = [];
        _detected = false;
        _fieldErrors.Clear();
        _error = null;
        _cfgEditor = null;
        _cfgSession = null;
        _cfgMessage = null;
    }

    private void New()
    {
        if (!_readOnly)
        {
            Begin(new CliOptions(), string.Empty, isNew: true);
        }
    }

    private void Edit(string name)
    {
        if (_readOnly)
        {
            return;
        }

        if (Manager.ProjectOptions(name) is { } options)
        {
            Begin(options, name, isNew: false);
        }
        else
        {
            _error = $"No project connection named '{name}'.";
        }
    }

    private void Cancel() => End();

    private void End()
    {
        _binding?.Dispose();
        _binding = null;
        _vm = null;
        _form = null;
        _project = Manager.Project();
    }

    private void Set(UiControl c, string? text)
    {
        var result = _binding!.SetText(c, text ?? string.Empty);
        if (result.IsValid)
        {
            _fieldErrors.Remove(c.Id);
        }
        else
        {
            _fieldErrors[c.Id] = result.Error ?? "Not valid.";
        }
    }

    private void SetBool(UiControl c, object? value) => _binding!.SetBool(c.Id, value is true);

    private void Toggle(ChoiceControl list, string option, object? value)
    {
        var selected = _binding!.GetSelection(list.Id).Where(s => s != option).ToList();
        if (value is true)
        {
            selected.Add(option);
        }

        _binding.SetSelection(list.Id, list.Options.Where(selected.Contains));
    }

    private async Task DetectAsync()
    {
        _detecting = true;
        try
        {
            _hits = await NetworkDiscovery.CreateDefault().DiscoverAsync(TimeSpan.FromSeconds(3));
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _hits = [];
        }

        _detecting = false;
        _detected = true;
    }

    private void Prefill(NetworkDeviceHit hit)
    {
        _vm!.Transport = hit.Transport;
        _vm.Host = hit.Address;
        _vm.Port = hit.Port.ToString(System.Globalization.CultureInfo.InvariantCulture);
        if (_isNew && string.IsNullOrWhiteSpace(_name))
        {
            _name = hit.Hostname ?? hit.DisplayName;
        }
    }

    private void Save()
    {
        if (_readOnly)
        {
            return;
        }

        var message = Manager.Upsert(_name.Trim(), DevTermConfiguration.ToProfileJson(_vm!.BuildOptions()));
        if (message is null)
        {
            _error = null;
            End();
        }
        else
        {
            _error = message;
        }
    }

    private void Delete(string name)
    {
        _confirmDelete = null;
        if (!_readOnly && !Manager.Remove(name))
        {
            _error = $"No project connection named '{name}'.";
        }

        _project = Manager.Project();
    }

    private async Task OpenAsync(string name)
    {
        if (_readOnly)
        {
            return;
        }

        try
        {
            _error = await Manager.OpenAsync(name) is null ? $"No project connection named '{name}'." : null;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _error = ex.Message;
        }
    }

    public void Dispose()
    {
        _subscription.Dispose();
        _binding?.Dispose();
    }
}
