<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>dev-term panel</title>
    <style>
        body { font: 14px system-ui, sans-serif; margin: 0; padding: 16px; background: #14181d; color: #dde3ea; }
        fieldset { border: 1px solid #38424f; margin-bottom: 12px; }
        legend { color: #8fb4d8; }
        .row { display: flex; gap: 8px; align-items: center; margin: 6px 0; flex-wrap: wrap; }
        .row > label { min-width: 12em; }
        p { overflow-wrap: anywhere; }
        .note { color: #8a96a3; }
        input[type=checkbox] { width: 16px; height: 16px; }
        input[type=range] { height: 20px; }
        .error { color: #ff8a80; }
        nav { display: flex; flex-wrap: wrap; gap: 8px 16px; margin-bottom: 12px; }
        nav a { color: #8fb4d8; }
        a { color: #8fb4d8; }
        .manifest-panes { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; }
        .manifest-panes fieldset { min-width: 0; }
        .captures { list-style: none; padding: 0; margin: 6px 0; display: flex; flex-direction: column; gap: 4px; }
        .captures button[aria-pressed=true] { outline: 2px solid #8fb4d8; }
        .preview { max-width: 100%; height: auto; border: 1px solid #38424f; background: #fff; }
        select, input[type=text], input[type=number], textarea { background: #1c232b; color: inherit; border: 1px solid #38424f; padding: 2px 4px; }
        textarea { width: 100%; box-sizing: border-box; font-family: monospace; }
    </style>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <nav><a href="profiles">Profiles</a><a href="connections">Connections</a><a href="panel">Panel</a><a href="playback">Playback</a><a href="monitor">Monitor</a><a href="routing">Routing</a><a href="themes">Themes</a><a href="converters">Converters</a><a href="manifest">Manifest</a></nav>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
