<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>dev-term panel</title>
    <style>
        body { font: 14px system-ui, sans-serif; margin: 0; padding: 16px; background: #14181d; color: #dde3ea; }
        fieldset { border: 1px solid #38424f; margin-bottom: 12px; }
        legend { color: #8fb4d8; }
        .row { display: flex; gap: 8px; align-items: center; margin: 6px 0; flex-wrap: wrap; }
        .row > label { min-width: 12em; }
        .note { color: #8a96a3; }
        input[type=checkbox] { width: 16px; height: 16px; }
        input[type=range] { height: 20px; }
        .error { color: #ff8a80; }
        nav { display: flex; gap: 16px; margin-bottom: 12px; }
        nav a { color: #8fb4d8; }
        select, input[type=text], input[type=number] { background: #1c232b; color: inherit; border: 1px solid #38424f; padding: 2px 4px; }
    </style>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <nav><a href="profiles">Profiles</a><a href="connections">Connections</a><a href="panel">Panel</a></nav>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
