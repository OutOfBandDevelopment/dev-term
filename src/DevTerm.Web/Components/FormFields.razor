@using DevTerm.UiDefinitions
@using DevTerm.UiDefinitions.Forms

@* A generated form (FormDefinitionGenerator) drawn as HTML fields over a FormBinding: the web's FormRenderer. *@
@foreach (var section in Definition.Sections)
{
    if (!Binding.IsVisible(section.VisibleWhen)) { continue; }
    <div class="formsection">
        @foreach (var c in section.Controls.Where(Shown))
        {
            var readOnly = ReadOnly || Binding.IsReadOnly(c.Id);
            <div class="row" data-field="@c.Id" title="@c.Description">
                <label>@c.Label</label>
                @switch (c)
                {
                    case ChoiceControl { Style: ChoiceStyle.CheckList } list:
                        @foreach (var option in list.Options)
                        {
                            <label><input type="checkbox" disabled="@readOnly" checked="@Binding.GetSelection(list.Id).Contains(option)" @onchange="e => Toggle(list, option, e.Value)" /> @option</label>
                        }
                        break;
                    case ChoiceControl choice:
                        <select disabled="@readOnly" @onchange="e => Set(choice, e.Value?.ToString())">
                            @foreach (var option in choice.Options)
                            {
                                <option value="@option" selected="@(option == Binding.GetText(choice.Id))">@option</option>
                            }
                        </select>
                        break;
                    case ToggleControl toggle:
                        <input type="checkbox" disabled="@readOnly" checked="@Binding.GetBool(toggle.Id)" @onchange="e => Binding.SetBool(toggle.Id, e.Value is true)" />
                        break;
                    default:
                        <input type="text" disabled="@readOnly" value="@Binding.GetText(c.Id)" @onchange="e => Set(c, e.Value?.ToString())" />
                        break;
                }
                @if (_errors.TryGetValue(c.Id, out var error)) { <span class="error">@error</span> }
            </div>
        }
    </div>
}

@code {
    private readonly Dictionary<string, string> _errors = [];

    [Parameter, EditorRequired] public UiDefinition Definition { get; set; } = default!;

    [Parameter, EditorRequired] public FormBinding Binding { get; set; } = default!;

    [Parameter] public bool ReadOnly { get; set; }

    private bool Shown(UiControl c) => c is not ButtonControl && Binding.Has(c.Id) && Binding.IsVisible(c.VisibleWhen);

    private void Set(UiControl c, string? text)
    {
        var result = Binding.SetText(c, text ?? string.Empty);
        if (result.IsValid)
        {
            _errors.Remove(c.Id);
        }
        else
        {
            _errors[c.Id] = result.Error ?? "Not valid.";
        }
    }

    private void Toggle(ChoiceControl list, string option, object? value)
    {
        var selected = Binding.GetSelection(list.Id).Where(s => s != option).ToList();
        if (value is true)
        {
            selected.Add(option);
        }

        Binding.SetSelection(list.Id, list.Options.Where(selected.Contains));
    }
}
